{# labrats/templates/config.html.j2 #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>labrats config</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
	font-family: system-ui, -apple-system, sans-serif;
	background: #f8f8f8;
	color: #1a1a1a;
	line-height: 1.5;
	height: 100vh;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}
header {
	padding: 0.75rem 1.25rem;
	border-bottom: 2px solid #1a1a1a;
	font-size: 1.1rem;
	font-weight: 700;
	background: #fff;
	flex-shrink: 0;
	letter-spacing: -0.01em;
}
.layout {
	display: flex;
	flex: 1;
	overflow: hidden;
}

/* ── sidebar ── */
.sidebar {
	width: 200px;
	flex-shrink: 0;
	background: #fff;
	border-right: 1px solid #ddd;
	overflow-y: auto;
	padding: 0.5rem 0;
}
.tab-btn {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	width: 100%;
	padding: 0.55rem 1rem;
	background: none;
	border: none;
	border-left: 3px solid transparent;
	cursor: pointer;
	font-size: 0.83rem;
	color: #555;
	text-align: left;
	gap: 0.5rem;
}
.tab-btn:hover { background: #f4f4f4; }
.tab-btn.active {
	color: #1a1a1a;
	font-weight: 600;
	border-left-color: #1a1a1a;
	background: #f8f8f8;
}
.tab-count {
	font-size: 0.72rem;
	color: #bbb;
	font-weight: normal;
	flex-shrink: 0;
}
.tab-btn.active .tab-count { color: #888; }

/* ── main content ── */
.content {
	flex: 1;
	overflow-y: auto;
	padding: 1.25rem 1.5rem;
}
.panel { display: none; max-width: 760px; }
.panel.active { display: block; }

/* ── cards ── */
.card {
	background: #fff;
	border: 1px solid #ddd;
	border-radius: 6px;
	padding: 1.25rem;
	margin-bottom: 1rem;
}
.card.disabled { opacity: 0.55; }
.card-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	gap: 1rem;
	margin-bottom: 0.4rem;
}
.card-title { font-size: 1rem; font-weight: 600; }
.card-meta {
	font-size: 0.78rem;
	color: #777;
	margin-bottom: 0.5rem;
}

/* ── badges ── */
.badges {
	display: flex;
	gap: 0.35rem;
	flex-wrap: wrap;
}
.badge {
	font-size: 0.73rem;
	font-weight: 600;
	padding: 0.15rem 0.45rem;
	border-radius: 3px;
	white-space: nowrap;
}
.badge-field { background: #e3f2fd; color: #1565c0; }
.badge-model { background: #f3e5f5; color: #7b1fa2; }
.badge-kw { background: #e8f5e9; color: #2e7d32; }
.badge-cat { background: #fff3e0; color: #e65100; }
.badge-arxiv { background: #fce4ec; color: #c62828; }

/* ── toggle switch ── */
.toggle {
	position: relative;
	width: 36px;
	height: 20px;
	flex-shrink: 0;
}
.toggle input {
	opacity: 0;
	width: 0;
	height: 0;
}
.toggle-slider {
	position: absolute;
	inset: 0;
	background: #ccc;
	border-radius: 20px;
	cursor: pointer;
	transition: background 0.2s;
}
.toggle-slider::before {
	content: "";
	position: absolute;
	width: 14px;
	height: 14px;
	left: 3px;
	bottom: 3px;
	background: #fff;
	border-radius: 50%;
	transition: transform 0.2s;
}
.toggle input:checked + .toggle-slider {
	background: #1a1a1a;
}
.toggle input:checked + .toggle-slider::before {
	transform: translateX(16px);
}

/* ── buttons ── */
.btn {
	padding: 0.3rem 0.75rem;
	border: 1px solid #ddd;
	border-radius: 3px;
	cursor: pointer;
	font-size: 0.78rem;
	background: none;
	color: #555;
}
.btn:hover { border-color: #999; color: #333; }
.btn-primary {
	background: #1a1a1a;
	color: #fff;
	border-color: #1a1a1a;
}
.btn-primary:hover {
	background: #333;
	border-color: #333;
}
.btn-danger {
	color: #c62828;
	border-color: #e57373;
}
.btn-danger:hover {
	background: #ffebee;
	border-color: #c62828;
}
.btn-row {
	display: flex;
	gap: 0.5rem;
	margin-top: 0.75rem;
}
.add-btn {
	margin-bottom: 1rem;
}

/* ── edit form ── */
.edit-form {
	display: none;
	margin-top: 0.75rem;
	padding-top: 0.75rem;
	border-top: 1px solid #eee;
}
.edit-form.open { display: block; }
.form-group {
	margin-bottom: 0.6rem;
}
.form-group > label {
	display: block;
	font-size: 0.75rem;
	font-weight: 600;
	color: #777;
	margin-bottom: 0.15rem;
	text-transform: uppercase;
	letter-spacing: 0.03em;
}
.form-group input,
.form-group textarea {
	width: 100%;
	padding: 0.4rem 0.55rem;
	border: 1px solid #ddd;
	border-radius: 3px;
	font-family: inherit;
	font-size: 0.83rem;
	color: #1a1a1a;
	background: #fafafa;
}
.form-group input:focus,
.form-group textarea:focus {
	outline: none;
	border-color: #999;
	background: #fff;
}
.form-group textarea {
	min-height: 60px;
	resize: vertical;
}
.form-hint {
	font-size: 0.7rem;
	color: #aaa;
	margin-top: 0.1rem;
}

/* ── checkbox grids ── */
.check-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
	gap: 1px;
	background: #eee;
	border: 1px solid #eee;
	border-radius: 3px;
	overflow: hidden;
}
.check-item {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	font-size: 0.72rem;
	color: #888;
	background: #fff;
	padding: 0.25rem 0.45rem;
	cursor: pointer;
	user-select: none;
}
.check-item:hover { background: #f8f8f8; }
.check-item:has(input:checked) {
	color: #1a1a1a;
	font-weight: 600;
	background: #f4f7ff;
}
.check-item input {
	accent-color: #1a1a1a;
	width: 12px;
	height: 12px;
	flex-shrink: 0;
}
.check-all {
	grid-column: 1 / -1;
	font-weight: 600;
	color: #555;
	background: #fafafa;
	border-bottom: 1px solid #ddd;
}

/* ── toast ── */
.toast {
	position: fixed;
	bottom: 1.5rem;
	right: 1.5rem;
	background: #1a1a1a;
	color: #fff;
	padding: 0.5rem 1rem;
	border-radius: 4px;
	font-size: 0.8rem;
	opacity: 0;
	transition: opacity 0.3s;
	pointer-events: none;
	z-index: 200;
}
.toast.show { opacity: 1; }
</style>
</head>
<body>
<header>labrats config</header>
<div class="layout">

  <nav class="sidebar">
    <button class="tab-btn active" id="tab-personas"
            onclick="showTab('personas')">
      <span>Personas</span>
      <span class="tab-count" id="cnt-personas">0</span>
    </button>
    <button class="tab-btn" id="tab-profiles"
            onclick="showTab('profiles')">
      <span>Profiles</span>
      <span class="tab-count" id="cnt-profiles">0</span>
    </button>
  </nav>

  <main class="content">

    <!-- ── Personas panel ── -->
    <div class="panel active" id="panel-personas">
      <button class="btn btn-primary add-btn"
              onclick="showNewPersona()">+ Add persona</button>
      <div id="new-persona-form" class="card" style="display:none">
        <div class="card-title" style="margin-bottom:0.5rem">
          New persona
        </div>
        <div id="new-persona-fields"></div>
      </div>
      <div id="persona-list"></div>
    </div>

    <!-- ── Profiles panel ── -->
    <div class="panel" id="panel-profiles">
      <button class="btn btn-primary add-btn"
              onclick="showNewProfile()">+ Add profile</button>
      <div id="new-profile-form" class="card" style="display:none">
        <div class="card-title" style="margin-bottom:0.5rem">
          New profile
        </div>
        <div id="new-profile-fields"></div>
      </div>
      <div id="profile-list"></div>
    </div>

  </main>
</div>

<div class="toast" id="toast"></div>

<script>
var personas = [];
var profiles = [];

var BIORXIV_CATEGORIES = [
  "animal behavior and cognition", "biochemistry", "bioengineering",
  "bioinformatics", "biophysics", "cancer biology", "cell biology",
  "clinical trials", "developmental biology", "ecology",
  "epidemiology", "evolutionary biology", "genetics", "genomics",
  "immunology", "microbiology", "molecular biology", "neuroscience",
  "paleontology", "pathology", "pharmacology and toxicology",
  "physiology", "plant biology",
  "scientific communication and education",
  "synthetic biology", "systems biology", "zoology"
];

var ARXIV_CATEGORIES = [
  "astro-ph", "cond-mat", "cs.AI", "cs.CL", "cs.CV", "cs.LG",
  "cs.RO", "eess.SP", "gr-qc", "hep-ex", "hep-ph", "hep-th",
  "math.CO", "math.OC", "math.ST", "nlin.CD",
  "physics.bio-ph", "physics.chem-ph", "physics.med-ph",
  "q-bio.BM", "q-bio.CB", "q-bio.GN", "q-bio.MN", "q-bio.NC",
  "q-bio.OT", "q-bio.PE", "q-bio.QM", "q-bio.SC", "q-bio.TO",
  "q-fin.ST", "stat.AP", "stat.ME", "stat.ML"
];

/* ── helpers ── */
function esc(s) {
  var d = document.createElement("div");
  d.textContent = s;
  return d.innerHTML;
}

function toast(msg) {
  var el = document.getElementById("toast");
  el.textContent = msg;
  el.classList.add("show");
  setTimeout(function() { el.classList.remove("show"); }, 1800);
}

function api(method, path, body) {
  var opts = { method: method, headers: {} };
  if (body !== undefined) {
    opts.headers["Content-Type"] = "application/json";
    opts.body = JSON.stringify(body);
  }
  return fetch(path, opts).then(function(r) { return r.json(); });
}

function checkboxesHTML(items, selected, valueFn, labelFn) {
  var allChecked = items.every(function(item) {
    var val = valueFn ? valueFn(item) : item;
    return selected.indexOf(val) !== -1;
  });
  var html = '<label class="check-item check-all">' +
    '<input type="checkbox"' +
      (allChecked ? " checked" : "") +
      ' onchange="toggleAll(this)">' +
    'Select all' +
  '</label>';
  html += items.map(function(item) {
    var val = valueFn ? valueFn(item) : item;
    var lbl = labelFn ? labelFn(item) : item;
    var checked = selected.indexOf(val) !== -1
      ? " checked" : "";
    return (
      '<label class="check-item">' +
        '<input type="checkbox" value="' + esc(val) +
          '"' + checked + '>' +
        esc(lbl) +
      '</label>'
    );
  }).join("");
  return html;
}

function toggleAll(masterCb) {
  var grid = masterCb.closest(".check-grid");
  var boxes = grid.querySelectorAll(
    'input[type=checkbox]:not([onchange])');
  boxes.forEach(function(cb) { cb.checked = masterCb.checked; });
}

function readChecked(container, selector) {
  return Array.from(container.querySelectorAll(
    selector + " input[type=checkbox]"
  )).filter(function(cb) {
    return cb.checked;
  }).map(function(cb) { return cb.value; });
}

/* ── tabs ── */
function showTab(name) {
  ["personas", "profiles"].forEach(function(t) {
    document.getElementById("tab-" + t)
      .classList.toggle("active", t === name);
    document.getElementById("panel-" + t)
      .classList.toggle("active", t === name);
  });
}

/* ── persona rendering ── */
function personaCardHTML(p) {
  var cls = p.enabled ? "card" : "card disabled";
  var fields = p.scored_fields.map(function(f) {
    return '<span class="badge badge-field">' + esc(f) + '</span>';
  }).join("");
  var model = p.model
    ? '<span class="badge badge-model">' + esc(p.model) + '</span>'
    : "";
  return (
    '<div class="' + cls + '" id="pc-' + esc(p.stem) + '">' +
      '<div class="card-header">' +
        '<div class="card-title">' + esc(p.name) + '</div>' +
        '<label class="toggle">' +
          '<input type="checkbox"' +
            (p.enabled ? " checked" : "") +
            ' onchange="togglePersonaEnabled(\'' +
              esc(p.stem) + '\')">' +
          '<span class="toggle-slider"></span>' +
        '</label>' +
      '</div>' +
      '<div class="card-meta">' +
        esc(p.role.substring(0, 120)) +
        (p.role.length > 120 ? "..." : "") +
      '</div>' +
      '<div class="badges">' + fields + model + '</div>' +
      '<div class="btn-row">' +
        '<button class="btn" onclick="toggleEdit(\'' +
          esc(p.stem) + '\')">Edit</button>' +
        '<button class="btn btn-danger" onclick="deletePersona(\'' +
          esc(p.stem) + '\')">Delete</button>' +
      '</div>' +
      '<div class="edit-form" id="ef-' + esc(p.stem) + '">' +
        personaFormHTML(p, "update") +
      '</div>' +
    '</div>'
  );
}

function personaFormHTML(p, mode) {
  var stem = p ? p.stem : "";
  var name = p ? p.name : "";
  var role = p ? p.role : "";
  var prompt = p ? p.prompt : "You are a {role}. Read the following paper and evaluate it.\nFor each scored field, provide a score from 1-10.\nGive a short, direct take (1-2 sentences).";
  var fields = p ? p.scored_fields.join(", ") : "methodological_rigor, novelty, relevance";
  var model = p ? (p.model || "") : "";
  var action = mode === "update"
    ? "savePersona('" + esc(stem) + "')"
    : "createPersona()";
  var cancel = mode === "update"
    ? "toggleEdit('" + esc(stem) + "')"
    : "hideNewPersona()";
  return (
    '<div class="form-group">' +
      '<label>Name</label>' +
      '<input type="text" class="pf-name" value="' +
        esc(name) + '">' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Role</label>' +
      '<textarea class="pf-role">' + esc(role) + '</textarea>' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Prompt</label>' +
      '<textarea class="pf-prompt" rows="3">' +
        esc(prompt) + '</textarea>' +
      '<div class="form-hint">Use {role} as a placeholder</div>' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Scored fields</label>' +
      '<input type="text" class="pf-fields" value="' +
        esc(fields) + '">' +
      '<div class="form-hint">Comma-separated</div>' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Model override</label>' +
      '<input type="text" class="pf-model" value="' +
        esc(model) + '">' +
      '<div class="form-hint">Leave blank for default</div>' +
    '</div>' +
    '<div class="btn-row">' +
      '<button class="btn btn-primary" onclick="' +
        action + '">Save</button>' +
      '<button class="btn" onclick="' +
        cancel + '">Cancel</button>' +
    '</div>'
  );
}

function renderPersonas() {
  var html = personas.map(personaCardHTML).join("");
  document.getElementById("persona-list").innerHTML = html;
  document.getElementById("cnt-personas").textContent =
    personas.length;
}

function readPersonaForm(container) {
  return {
    name: container.querySelector(".pf-name").value.trim(),
    role: container.querySelector(".pf-role").value.trim(),
    prompt: container.querySelector(".pf-prompt").value.trim(),
    scored_fields: container.querySelector(".pf-fields")
      .value.split(",").map(function(s) {
        return s.trim();
      }).filter(Boolean),
    model: container.querySelector(".pf-model").value.trim() || null,
    enabled: true,
  };
}

/* ── persona actions ── */
function showNewPersona() {
  var wrap = document.getElementById("new-persona-form");
  wrap.style.display = "block";
  document.getElementById("new-persona-fields").innerHTML =
    personaFormHTML(null, "create");
}

function hideNewPersona() {
  document.getElementById("new-persona-form").style.display = "none";
}

function createPersona() {
  var container = document.getElementById("new-persona-fields");
  var data = readPersonaForm(container);
  if (!data.name) return toast("Name is required");
  if (!data.scored_fields.length)
    return toast("At least one scored field is required");
  api("POST", "/api/personas", data).then(function(res) {
    personas = res;
    renderPersonas();
    renderProfiles();
    hideNewPersona();
    toast("Persona created");
  });
}

function toggleEdit(stem) {
  var el = document.getElementById("ef-" + stem);
  el.classList.toggle("open");
}

function savePersona(stem) {
  var container = document.getElementById("ef-" + stem);
  var data = readPersonaForm(container);
  var orig = personas.find(function(p) {
    return p.stem === stem;
  });
  if (orig) data.enabled = orig.enabled;
  if (!data.name) return toast("Name is required");
  if (!data.scored_fields.length)
    return toast("At least one scored field is required");
  api("PUT", "/api/personas/" + encodeURIComponent(stem),
    data).then(function(res) {
    personas = res;
    renderPersonas();
    renderProfiles();
    toast("Persona saved");
  });
}

function deletePersona(stem) {
  if (!confirm("Delete this persona?")) return;
  api("DELETE", "/api/personas/" + encodeURIComponent(stem))
    .then(function(res) {
      personas = res;
      renderPersonas();
      renderProfiles();
      toast("Persona deleted");
    });
}

function togglePersonaEnabled(stem) {
  var p = personas.find(function(x) {
    return x.stem === stem;
  });
  if (!p) return;
  var data = Object.assign({}, p, { enabled: !p.enabled });
  delete data.stem;
  api("PUT", "/api/personas/" + encodeURIComponent(stem),
    data).then(function(res) {
    personas = res;
    renderPersonas();
    renderProfiles();
    toast(data.enabled ? "Enabled" : "Disabled");
  });
}

/* ── profile rendering ── */
function profileCardHTML(prof, idx) {
  var kws = (prof.keywords || []).map(function(k) {
    return '<span class="badge badge-kw">' + esc(k) + '</span>';
  }).join("");
  var cats = (prof.categories || []).map(function(c) {
    return '<span class="badge badge-cat">' + esc(c) + '</span>';
  }).join("");
  var arxiv = (prof.arxiv_categories || []).map(function(c) {
    return '<span class="badge badge-arxiv">' + esc(c) + '</span>';
  }).join("");
  var assigned = prof.personas || [];
  var assignedText = assigned.length
    ? assigned.length + " persona" +
      (assigned.length > 1 ? "s" : "") + " assigned"
    : "all personas";
  var maxP = prof.max_papers || 500;
  return (
    '<div class="card" id="prc-' + idx + '">' +
      '<div class="card-header">' +
        '<div class="card-title">' + esc(prof.name) + '</div>' +
        '<span style="font-size:0.75rem;color:#999">' +
          esc(assignedText) +
          ' &middot; max ' + maxP +
        '</span>' +
      '</div>' +
      '<div class="badges" style="margin-bottom:0.3rem">' +
        kws + cats + arxiv +
      '</div>' +
      '<div class="btn-row">' +
        '<button class="btn" onclick="toggleProfileEdit(' +
          idx + ')">Edit</button>' +
        '<button class="btn btn-danger" onclick="deleteProfile(' +
          idx + ')">Delete</button>' +
      '</div>' +
      '<div class="edit-form" id="pef-' + idx + '">' +
        profileFormHTML(prof, idx, "update") +
      '</div>' +
    '</div>'
  );
}

function profileFormHTML(prof, idx, mode) {
  var name = prof ? prof.name : "";
  var kws = prof ? (prof.keywords || []).join(", ") : "";
  var selCats = prof ? (prof.categories || []) : [];
  var selArxiv = prof ? (prof.arxiv_categories || []) : [];
  var maxP = prof ? (prof.max_papers || 500) : 500;
  var assigned = prof ? (prof.personas || []) : [];
  var action = mode === "update"
    ? "saveProfile(" + idx + ")"
    : "createProfile()";
  var cancel = mode === "update"
    ? "toggleProfileEdit(" + idx + ")"
    : "hideNewProfile()";

  var catChecks = checkboxesHTML(
    BIORXIV_CATEGORIES, selCats);
  var arxivChecks = checkboxesHTML(
    ARXIV_CATEGORIES, selArxiv);
  var personaChecks = checkboxesHTML(
    personas, assigned,
    function(p) { return p.stem; },
    function(p) { return p.name; });

  return (
    '<div class="form-group">' +
      '<label>Name</label>' +
      '<input type="text" class="pr-name" value="' +
        esc(name) + '">' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Keywords</label>' +
      '<input type="text" class="pr-kws" value="' +
        esc(kws) + '">' +
      '<div class="form-hint">Comma-separated</div>' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Categories (biorxiv)</label>' +
      '<div class="check-grid pr-cats">' +
        catChecks +
      '</div>' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Categories (arxiv)</label>' +
      '<div class="check-grid pr-arxiv">' +
        arxivChecks +
      '</div>' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Max papers</label>' +
      '<input type="number" class="pr-max" value="' +
        maxP + '" min="1">' +
    '</div>' +
    '<div class="form-group">' +
      '<label>Personas</label>' +
      '<div class="check-grid pr-personas">' +
        personaChecks +
      '</div>' +
      '<div class="form-hint">' +
        'Unchecking all = use all enabled personas' +
      '</div>' +
    '</div>' +
    '<div class="btn-row">' +
      '<button class="btn btn-primary" onclick="' +
        action + '">Save</button>' +
      '<button class="btn" onclick="' +
        cancel + '">Cancel</button>' +
    '</div>'
  );
}

function renderProfiles() {
  var html = profiles.map(profileCardHTML).join("");
  document.getElementById("profile-list").innerHTML = html;
  document.getElementById("cnt-profiles").textContent =
    profiles.length;
}

function readProfileForm(container) {
  var selected = readChecked(container, ".pr-personas");
  var data = {
    name: container.querySelector(".pr-name").value.trim(),
    keywords: container.querySelector(".pr-kws")
      .value.split(",").map(function(s) {
        return s.trim();
      }).filter(Boolean),
    categories: readChecked(container, ".pr-cats"),
    arxiv_categories: readChecked(container, ".pr-arxiv"),
    max_papers: parseInt(
      container.querySelector(".pr-max").value, 10
    ) || 500,
  };
  if (selected.length) data.personas = selected;
  return data;
}

/* ── profile actions ── */
function showNewProfile() {
  var wrap = document.getElementById("new-profile-form");
  wrap.style.display = "block";
  document.getElementById("new-profile-fields").innerHTML =
    profileFormHTML(null, -1, "create");
}

function hideNewProfile() {
  document.getElementById("new-profile-form").style.display = "none";
}

function createProfile() {
  var container = document.getElementById("new-profile-fields");
  var data = readProfileForm(container);
  if (!data.name) return toast("Name is required");
  if (!data.keywords.length && !data.categories.length)
    return toast("Need at least one keyword or category");
  api("POST", "/api/profiles", data).then(function(res) {
    profiles = res;
    renderProfiles();
    hideNewProfile();
    toast("Profile created");
  });
}

function toggleProfileEdit(idx) {
  var el = document.getElementById("pef-" + idx);
  el.classList.toggle("open");
}

function saveProfile(idx) {
  var container = document.getElementById("pef-" + idx);
  var data = readProfileForm(container);
  if (!data.name) return toast("Name is required");
  api("PUT", "/api/profiles/" + idx, data).then(function(res) {
    profiles = res;
    renderProfiles();
    toast("Profile saved");
  });
}

function deleteProfile(idx) {
  if (!confirm("Delete this profile?")) return;
  api("DELETE", "/api/profiles/" + idx).then(function(res) {
    profiles = res;
    renderProfiles();
    toast("Profile deleted");
  });
}

/* ── init ── */
function init() {
  Promise.all([
    api("GET", "/api/personas"),
    api("GET", "/api/profiles"),
  ]).then(function(res) {
    personas = res[0];
    profiles = res[1];
    renderPersonas();
    renderProfiles();
  });
}

init();
</script>
</body>
</html>
