    toast("Profile created");
    // also refresh sidebar
    api("GET", "/api/digest").then(function(dp) {
      digestProfiles = dp;
      renderSidebar();
    });
  });
}
function toggleProfileEdit(idx) {
  document.getElementById("pef-" + idx).classList.toggle("open");
}
function saveProfile(idx) {
  var container = document.getElementById("pef-" + idx);
  var data = readProfileForm(container);
  if (!data.name) return toast("Name is required");
  api("PUT", "/api/profiles/" + idx, data).then(function(res) {
    profiles = res;
    renderProfiles();
    toast("Profile saved");
    api("GET", "/api/digest").then(function(dp) {
      digestProfiles = dp;
      renderSidebar();
    });
  });
}
function deleteProfile(idx) {
  if (!confirm("Delete this profile?")) return;
  api("DELETE", "/api/profiles/" + idx).then(function(res) {
    profiles = res;
    renderProfiles();
    toast("Profile deleted");
    api("GET", "/api/digest").then(function(dp) {
      digestProfiles = dp;
      renderSidebar();
    });
  });
}

/* ── settings rendering ── */
function renderDefaultModel() {
  var val = settingsData.default_model || "";
  var html =
    '<div class="form-group">' +
      modelInputHTML("st-default-model", val) +
    '</div>';

  var local = (modelsData && modelsData.local) || {};
  var labels = Object.keys(local);
  var cloud = (modelsData && modelsData.cloud) || {};
  var activeCloud = Object.keys(cloud).filter(function(p) {
    return cloud[p].active;
  });

  if (labels.length || activeCloud.length) {
    html += '<div style="margin-top:0.75rem;' +
      'font-size:0.78rem;color:#555">' +
      '<div style="font-weight:600;' +
        'margin-bottom:0.35rem">' +
        'Available models</div>';
  }
  labels.forEach(function(label) {
    var models = local[label] || [];
    html += '<div style="margin-bottom:0.5rem">' +
      '<span style="color:#2e7d32;font-weight:600;' +
        'font-size:0.75rem">' + esc(label) + '</span>' +
      '<div style="display:flex;flex-wrap:wrap;' +
        'gap:0.3rem;margin-top:0.25rem">';
    models.forEach(function(m) {
      html += '<span class="badge badge-model" ' +
        'style="cursor:pointer" ' +
        'onclick="pickModel(\'' + esc(m) + '\')">' +
        esc(m) + '</span>';
    });
    html += '</div></div>';
  });
  activeCloud.forEach(function(provider) {
    var info = cloud[provider];
    var models = info.models || [];
    var doc = info.docs || "";
    var link = doc
      ? ' <a href="' + esc(doc) + '" target="_blank" ' +
          'style="font-size:0.7rem;color:#999;' +
          'text-decoration:none">[all models]</a>'
      : "";
    html += '<details style="margin-bottom:0.5rem">' +
      '<summary style="cursor:pointer;font-size:0.75rem;' +
        'color:#2e7d32;font-weight:600">' +
        esc(provider) +
        ' <span style="font-weight:normal;color:#999">' +
          '(' + models.length + ')</span>' +
        link + '</summary>' +
      '<div style="display:flex;flex-wrap:wrap;' +
        'gap:0.3rem;margin-top:0.25rem;' +
        'padding-left:0.5rem">';
    models.forEach(function(m) {
      html += '<span class="badge badge-model" ' +
        'style="cursor:pointer" ' +
        'onclick="pickModel(\'' + esc(m) + '\')">' +
        esc(m) + '</span>';
    });
    html += '</div></details>';
  });
  if (labels.length || activeCloud.length) {
    html += '</div>';
  }
  document.getElementById("default-model-field").innerHTML =
    html;
}

function pickModel(name) {
  var el = document.querySelector(".st-default-model");
  if (el) el.value = name;
}

function renderSettings() {
  renderDefaultModel();
  var keys = settingsData.api_keys || {};
  var html = PROVIDERS.map(function(p) {
    var val = keys[p.key] || "";
    var cloud = (modelsData && modelsData.cloud) || {};
    var info = cloud[p.key] || {};
    var active = info.active || false;
    var dot = active
      ? '<span style="color:#2e7d32;font-size:1.1em">' +
          '&#9679;</span>'
      : '<span style="color:#ccc;font-size:1.1em">' +
          '&#9679;</span>';
    var docs = info.docs || "";
    var docsLink = docs
      ? ' <a href="' + esc(docs) + '" target="_blank" ' +
          'style="font-size:0.72rem;color:#999;' +
          'text-decoration:none">[models]</a>'
      : "";
    return (
      '<div class="form-group">' +
        '<label>' + dot + ' ' + esc(p.label) +
          docsLink +
          ' <span style="font-weight:normal;color:#aaa">' +
            '($' + p.env + ')</span></label>' +
        '<div style="display:flex;gap:0.5rem;' +
          'align-items:center">' +
          '<input type="password" class="sk-' +
            p.key + '" value="' + esc(val) + '" ' +
            'style="flex:1;padding:0.4rem 0.55rem;' +
            'border:1px solid #ddd;border-radius:3px;' +
            'font-family:monospace;font-size:0.83rem;' +
            'color:#1a1a1a;background:#fafafa">' +
          '<button class="btn" onclick="toggleVis(this)"' +
            ' style="flex-shrink:0">Show</button>' +
        '</div>' +
      '</div>'
    );
  }).join("");
  document.getElementById("settings-fields").innerHTML = html;
}

function toggleVis(btn) {
  var input = btn.previousElementSibling;
  if (input.type === "password") {
    input.type = "text"; btn.textContent = "Hide";
  } else {
    input.type = "password"; btn.textContent = "Show";
  }
}

function saveDefaultModel() {
  var el = document.querySelector(".st-default-model");
  var val = el ? el.value.trim() : "";
  api("PUT", "/api/settings", { default_model: val })
    .then(function() {
      toast("Default model saved");
      api("GET", "/api/settings").then(function(res) {
        settingsData = res;
        renderDefaultModel();
      });
    });
}

function saveApiKeys() {
  var keys = {};
  PROVIDERS.forEach(function(p) {
    var el = document.querySelector(".sk-" + p.key);
    if (el) keys[p.key] = el.value.trim();
  });
  api("PUT", "/api/settings", { api_keys: keys })
    .then(function() {
      toast("API keys saved");
      Promise.all([
        api("GET", "/api/settings"),
        api("GET", "/api/models"),
      ]).then(function(res) {
        settingsData = res[0];
        modelsData = res[1];
        renderSettings();
      });
    });
}

/* ── init ── */
function init() {
  Promise.all([
    api("GET", "/api/personas"),
    api("GET", "/api/profiles"),
    api("GET", "/api/settings"),
    api("GET", "/api/models"),
    api("GET", "/api/digest"),
  ]).then(function(res) {
    personas = res[0];
    profiles = res[1];
    settingsData = res[2];
    modelsData = res[3];
    digestProfiles = res[4];
    renderPersonas();
    renderProfiles();
    renderSettings();
    renderSidebar();
    if (digestProfiles.length) {
      showDigest(digestProfiles[0].name);
    } else {
      document.getElementById("digest-content").innerHTML =
        '<div class="empty-state">' +
          '<h2>Welcome to labrats</h2>' +
          '<p>Configure your profiles in Settings, then ' +
            'click Run.</p>' +
        '</div>';
    }
  });
}

init();
</script>
</body>
</html>
