{# labrats/templates/digest.html.j2 #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>labrats digest</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body {
	font-family: system-ui, -apple-system, sans-serif;
	background: #f8f8f8;
	color: #1a1a1a;
	line-height: 1.5;
	height: 100vh;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}
header {
	padding: 0.75rem 1.25rem;
	border-bottom: 2px solid #1a1a1a;
	font-size: 1.1rem;
	font-weight: 700;
	background: #fff;
	flex-shrink: 0;
	letter-spacing: -0.01em;
}
.layout {
	display: flex;
	flex: 1;
	overflow: hidden;
}

/* ── sidebar ── */
.sidebar {
	width: 200px;
	flex-shrink: 0;
	background: #fff;
	border-right: 1px solid #ddd;
	overflow-y: auto;
	padding: 0.5rem 0;
}
.tab-btn {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	width: 100%;
	padding: 0.55rem 1rem;
	background: none;
	border: none;
	border-left: 3px solid transparent;
	cursor: pointer;
	font-size: 0.83rem;
	color: #555;
	text-align: left;
	gap: 0.5rem;
}
.tab-btn:hover { background: #f4f4f4; }
.tab-btn.active {
	color: #1a1a1a;
	font-weight: 600;
	border-left-color: #1a1a1a;
	background: #f8f8f8;
}
.tab-count {
	font-size: 0.72rem;
	color: #bbb;
	font-weight: normal;
	flex-shrink: 0;
}
.tab-btn.active .tab-count { color: #888; }

/* ── main content ── */
.content {
	flex: 1;
	overflow-y: auto;
	padding: 1.25rem 1.5rem;
}
.panel { display: none; max-width: 760px; }
.panel.active { display: block; }

/* ── sort controls ── */
.panel-controls {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	margin-bottom: 1rem;
	font-size: 0.78rem;
	color: #999;
}
.sort-btn {
	padding: 0.18rem 0.55rem;
	background: none;
	border: 1px solid #ddd;
	border-radius: 3px;
	cursor: pointer;
	font-size: 0.76rem;
	color: #666;
}
.sort-btn:hover { border-color: #999; color: #333; }
.sort-btn.active {
	background: #1a1a1a;
	color: #fff;
	border-color: #1a1a1a;
}

/* ── paper card ── */
.card {
	background: #fff;
	border: 1px solid #ddd;
	border-radius: 6px;
	padding: 1.25rem;
	margin-bottom: 1rem;
}
.card-header {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	gap: 1rem;
	margin-bottom: 0.6rem;
}
.card-title { font-size: 1rem; font-weight: 600; }
.card-title a { color: #1a1a1a; text-decoration: none; }
.card-title a:hover { text-decoration: underline; }
.card-meta {
	font-size: 0.78rem;
	color: #777;
	margin-bottom: 0.75rem;
}
.badges {
	display: flex;
	gap: 0.35rem;
	flex-shrink: 0;
}
.badge {
	font-size: 0.73rem;
	font-weight: 600;
	padding: 0.15rem 0.45rem;
	border-radius: 3px;
	white-space: nowrap;
}
.badge-interest { background: #e8f5e9; color: #2e7d32; }
.badge-tension  { background: #fff3e0; color: #e65100; }

/* ── tooltip ── */
.tooltip-wrap {
	position: relative;
	cursor: help;
}
.tooltip-box {
	display: none;
	position: absolute;
	top: calc(100% + 6px);
	right: 0;
	min-width: 230px;
	background: #1e1e1e;
	color: #e8e8e8;
	font-size: 0.76rem;
	font-weight: normal;
	padding: 0.6rem 0.75rem;
	border-radius: 5px;
	line-height: 1.7;
	z-index: 100;
	pointer-events: none;
}
.tooltip-box .t-head {
	font-weight: 700;
	font-size: 0.82rem;
	margin-bottom: 0.2rem;
}
.tooltip-box .t-formula {
	color: #aaa;
	margin-bottom: 0.35rem;
}
.tooltip-box .t-divider {
	border: none;
	border-top: 1px solid #3a3a3a;
	margin: 0.35rem 0;
}
.tooltip-box .t-persona { color: #ccc; font-weight: 600; }
.tooltip-box .t-scores  { color: #aaa; padding-left: 0.5rem; }
.tooltip-wrap:hover .tooltip-box { display: block; }

/* ── abstract ── */
.abstract {
	font-size: 0.83rem;
	color: #444;
	line-height: 1.6;
	margin-bottom: 0.9rem;
	padding-left: 0.75rem;
	border-left: 3px solid #ececec;
}

/* ── persona buttons ── */
.persona-row {
	display: flex;
	flex-wrap: wrap;
	gap: 0.35rem;
	margin-top: 0.5rem;
}
.persona-btn {
	padding: 0.18rem 0.6rem;
	background: none;
	border: 1px solid #ddd;
	border-radius: 3px;
	cursor: pointer;
	font-size: 0.75rem;
	color: #555;
}
.persona-btn:hover { border-color: #888; color: #1a1a1a; }
.persona-btn.active {
	background: #1a1a1a;
	color: #fff;
	border-color: #1a1a1a;
}

/* ── persona detail panel ── */
.persona-detail {
	display: none;
	margin-top: 0.6rem;
	padding: 0.6rem 0.75rem;
	background: #fafafa;
	border: 1px solid #e8e8e8;
	border-radius: 4px;
}
.persona-detail-scores {
	font-size: 0.75rem;
	color: #777;
	margin-bottom: 0.3rem;
}
.persona-detail-model {
	font-size: 0.7rem;
	color: #bbb;
	margin-top: 0.3rem;
}
.persona-detail-summary {
	font-size: 0.83rem;
	color: #222;
	line-height: 1.55;
}
</style>
</head>
<body>
<header>labrats digest</header>
<div class="layout">

  <nav class="sidebar">
  {% for name, cards in sections %}
    <button class="tab-btn{% if loop.first %} active{% endif %}"
            id="tab-{{ loop.index0 }}"
            onclick="showTab({{ loop.index0 }})">
      <span>{{ name }}</span>
      <span class="tab-count">{{ cards | length }}</span>
    </button>
  {% endfor %}
  </nav>

  <main class="content">
  {% for name, cards in sections %}
    <div class="panel{% if loop.first %} active{% endif %}"
         id="panel-{{ loop.index0 }}">

      <div class="panel-controls">
        Sort by
        <button class="sort-btn active"
                onclick="sortCards('panel-{{ loop.index0 }}', 'score', this)">
          score
        </button>
        <button class="sort-btn"
                onclick="sortCards('panel-{{ loop.index0 }}', 'date', this)">
          date
        </button>
      </div>

    {% set gns = namespace(cid=0) %}
    {% for card in cards %}
      {% set gns.cid = gns.cid + 1 %}
      {# compute avg score for tooltip #}
      {% set ns = namespace(total=0.0, cnt=0) %}
      {% for r in card.results %}
        {% for v in r.scores.values() %}
          {% set ns.total = ns.total + v %}
          {% set ns.cnt = ns.cnt + 1 %}
        {% endfor %}
      {% endfor %}
      {% set avg = (ns.total / ns.cnt) if ns.cnt > 0 else 0.0 %}

      <div class="card"
           data-score="{{ "%.6f"|format(card.interestingness) }}"
           data-date="{{ card.paper.date }}">
        <div class="card-header">
          <div class="card-title">
            <a href="{{ card.paper.url }}" target="_blank">
              {{ card.paper.title }}
            </a>
          </div>
          <div class="badges">
            <span class="badge badge-interest tooltip-wrap">
              {{ "%.1f"|format(card.interestingness) }}
              <span class="tooltip-box">
                <div class="t-head">
                  Interestingness:
                  {{ "%.2f"|format(card.interestingness) }}
                </div>
                <div class="t-formula">
                  0.6 &times; avg_score
                  ({{ "%.2f"|format(avg) }})
                  + 0.4 &times; tension
                  ({{ "%.2f"|format(card.tension) }})
                </div>
                {% if card.results %}
                <hr class="t-divider">
                {% for r in card.results %}
                <div class="t-persona">
                  {{ r.persona_name }}
                </div>
                <div class="t-scores">
                  {% for k, v in r.scores.items() %}
                  {{ k }}: {{ "%.0f"|format(v) }}
                  {% if not loop.last %} &middot; {% endif %}
                  {% endfor %}
                </div>
                {% endfor %}
                {% endif %}
              </span>
            </span>
            {% if card.tension > 1.0 %}
            <span class="badge badge-tension">
              tension {{ "%.1f"|format(card.tension) }}
            </span>
            {% endif %}
          </div>
        </div>

        <div class="card-meta">
          {{ card.paper.authors | join(", ") }}
          &middot; {{ card.paper.category }}
          &middot; {{ card.paper.date }}
        </div>

        <p class="abstract">{{ card.paper.abstract }}</p>

        {% if card.results %}
        <div class="persona-row">
          {% for result in card.results %}
          <button class="persona-btn"
                  data-target="pd-{{ gns.cid }}-{{ loop.index0 }}"
                  onclick="togglePersona(this)">
            {{ result.persona_name }}
          </button>
          {% endfor %}
        </div>
        {% for result in card.results %}
        <div class="persona-detail"
             id="pd-{{ gns.cid }}-{{ loop.index0 }}">
          <div class="persona-detail-scores">
            {% for k, v in result.scores.items() %}
            {{ k }}: {{ "%.0f"|format(v) }}
            {% if not loop.last %}&middot;{% endif %}
            {% endfor %}
          </div>
          <div class="persona-detail-summary">
            {{ result.summary }}
          </div>
          {% if result.model %}
          <div class="persona-detail-model">{{ result.model }}</div>
          {% endif %}
        </div>
        {% endfor %}
        {% endif %}
      </div>
    {% endfor %}

    </div>
  {% endfor %}
  </main>

</div>
<script>
function showTab(i) {
  document.querySelectorAll('.tab-btn').forEach(function(b, j) {
    b.classList.toggle('active', i === j);
  });
  document.querySelectorAll('.panel').forEach(function(p, j) {
    p.classList.toggle('active', i === j);
  });
}

function togglePersona(btn) {
  var id = btn.dataset.target;
  var panel = document.getElementById(id);
  var open = panel.style.display === 'block';
  panel.style.display = open ? 'none' : 'block';
  btn.classList.toggle('active', !open);
}

function sortCards(panelId, key, btn) {
  var panel = document.getElementById(panelId);
  var cards = Array.from(panel.querySelectorAll('.card'));
  if (key === 'score') {
    cards.sort(function(a, b) {
      return parseFloat(b.dataset.score)
           - parseFloat(a.dataset.score);
    });
  } else {
    cards.sort(function(a, b) {
      if (b.dataset.date > a.dataset.date) return 1;
      if (b.dataset.date < a.dataset.date) return -1;
      return 0;
    });
  }
  cards.forEach(function(c) { panel.appendChild(c); });
  panel.querySelectorAll('.sort-btn').forEach(function(b) {
    b.classList.remove('active');
  });
  btn.classList.add('active');
}
</script>
</body>
</html>
